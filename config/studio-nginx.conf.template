# Basic-Auth gateway for the WGOS studio. Processed by the official nginx image's
# envsubst-on-templates step at start: ${STUDIO_BACKEND_TOKEN} is substituted from
# env (nginx runtime vars like $host are left intact because they are not in env).
#
# Two surfaces, both behind one HTTP Basic Auth realm:
#   /              -> studio (Next.js) container
#   /workgraph-os/ -> backend directly, with a server-side bearer token injected
#                     so the production-gated WGOS API works without ever exposing
#                     the token to the browser.
server {
  listen 80;
  server_name _;

  # Studio asset upload accepts up to 100mb (/workgraph-os/assets/upload).
  client_max_body_size 110m;

  auth_basic "WGOS Studio";
  auth_basic_user_file /etc/nginx/.htpasswd;

  location /workgraph-os/ {
    proxy_pass http://backend:4100;
    proxy_http_version 1.1;
    proxy_set_header Authorization "Bearer ${STUDIO_BACKEND_TOKEN}";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /health {
    proxy_pass http://backend:4100/health;
    proxy_set_header Authorization "Bearer ${STUDIO_BACKEND_TOKEN}";
    proxy_set_header Host $host;
  }

  location / {
    proxy_pass http://studio:3203;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Next.js HMR / any websocket upgrades.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
