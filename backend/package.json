{
  "name": "@sparkcanvas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:workgraph-os": "PORT=${WGOS_BACKEND_PORT:-4200} tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sparkcanvas/asset-store": "file:../packages/asset-store",
    "@sparkcanvas/brand-store": "file:../packages/brand-store",
    "@sparkcanvas/core": "file:../packages/core",
    "@sparkcanvas/database": "file:../packages/database",
    "@sparkcanvas/memory-engine": "file:../packages/memory-engine",
    "@sparkcanvas/model-router": "file:../packages/model-router",
    "@sparkcanvas/pi-adapter": "file:../packages/pi-adapter",
    "@sparkcanvas/skill-runtime": "file:../packages/skill-runtime",
    "@sparkcanvas/workflow-engine": "file:../packages/workflow-engine",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "pdfkit": "^0.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
